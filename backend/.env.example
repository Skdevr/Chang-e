# Copie este arquivo para backend/.env e ajuste conforme o ambiente local.
# Nao versione o arquivo .env.
# Todos os valores abaixo sao locais e nao devem ser usados fora de desenvolvimento.

# Nome do servico exposto pelo health check.
APP_NAME=change-api

# Ambiente de execucao: local, test, staging ou production.
ENVIRONMENT=local

# Prefixo das rotas versionadas da API.
API_V1_PREFIX=/api/v1

# Conexao assincrona com o PostgreSQL.
# Use o host "db" ao executar via Docker Compose e "localhost" fora dele.
DATABASE_URL=postgresql+asyncpg://change:local_password@db:5432/change

# Origens autorizadas para CORS, em formato JSON.
CORS_ORIGINS=["http://localhost:5173"]
